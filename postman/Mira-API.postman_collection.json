{
	"info": {
		"_postman_id": "mira-api-collection",
		"name": "Mira API",
		"description": "API collection for Mira - AI Companion That Remembers Who You Are",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "test-user",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health & System",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Check if the server is running"
					}
				},
				{
					"name": "API Test",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/test",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "test"]
						},
						"description": "Test API connectivity"
					}
				},
				{
					"name": "System Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stats"]
						},
						"description": "Get system statistics"
					}
				}
			]
		},
		{
			"name": "Chat",
			"item": [
				{
					"name": "1. First Message - Introduce Yourself",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"Hi! I'm Sophie. I'm a UX designer and I have a job interview at Google tomorrow. My dog Max helps me relax when I'm stressed.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Send first message introducing yourself. Mira will extract and store facts about you."
					}
				},
				{
					"name": "2. Test Memory Recall",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"Hey! Do you remember what I told you about myself?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Test if Mira remembers facts from the previous message (Sophie, UX designer, Google interview, dog Max)"
					}
				},
				{
					"name": "3. Test Goal Follow-up",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"The interview went great! I got the job!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Follow up on the Google interview goal"
					}
				},
				{
					"name": "4. Add New Memory",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"By the way, I'm training for a marathon in 3 months. Running helps me clear my head.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Add new information about goals and hobbies"
					}
				},
				{
					"name": "Chat with Language (French)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"Salut! Comment tu vas aujourd'hui?\",\n    \"lang\": \"fr\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Chat in French (set lang to 'fr')"
					}
				},
				{
					"name": "Chat with Language (English)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"message\": \"Hey what's up?\",\n    \"lang\": \"en\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat",
							"host": ["{{baseUrl}}"],
							"path": ["chat"]
						},
						"description": "Chat in English (set lang to 'en')"
					}
				}
			]
		},
		{
			"name": "Memory",
			"item": [
				{
					"name": "Get User Memories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/memories?userId={{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "memories"],
							"query": [
								{
									"key": "userId",
									"value": "{{userId}}"
								}
							]
						},
						"description": "Get all semantic memories stored for a user"
					}
				},
				{
					"name": "Get Memories by Category",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/memories?userId={{userId}}&category=goals",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "memories"],
							"query": [
								{
									"key": "userId",
									"value": "{{userId}}"
								},
								{
									"key": "category",
									"value": "goals"
								}
							]
						},
						"description": "Get memories filtered by category (personal, professional, relationship, goals, emotional, preferences, health)"
					}
				}
			]
		},
		{
			"name": "Profile",
			"item": [
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/profile/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profile", "{{userId}}"]
						},
						"description": "Get generated user profile with summary and active goals"
					}
				}
			]
		},
		{
			"name": "User Management",
			"item": [
				{
					"name": "List All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users"]
						},
						"description": "Get list of all user IDs in the system"
					}
				},
				{
					"name": "Delete User Data",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "{{userId}}"]
						},
						"description": "Delete all data for a user (messages, memories, goals, profile)"
					}
				}
			]
		},
		{
			"name": "Messages API",
			"item": [
				{
					"name": "Get User Greeting",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"lang\": \"en\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/messages/greeting",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "messages", "greeting"]
						},
						"description": "Get a personalized greeting for a user (different for new vs returning users)"
					}
				},
				{
					"name": "Chat (Full Endpoint)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"conversationId\": \"conv-123\",\n    \"content\": \"Hello! How are you today?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/messages/chat",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "messages", "chat"]
						},
						"description": "Alternative chat endpoint with full options"
					}
				},
				{
					"name": "Get Conversation History",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/messages/history?userId={{userId}}&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "messages", "history"],
							"query": [
								{
									"key": "userId",
									"value": "{{userId}}"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "Get conversation history for a user"
					}
				}
			]
		}
	]
}
