# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mira

# ===========================================
# LLM API Keys (configure at least one)
# Models are tried in order: Gemini → Claude → Mistral
# Leave empty or remove to disable a model
# ===========================================

# Google Gemini (primary)
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude (fallback 1)
ANTHROPIC_API_KEY=

# Mistral (fallback 2)
MISTRAL_API_KEY=

# ===========================================

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=  # Optional: Only needed for Qdrant Cloud

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# Gradium TTS/STT (optional - for voice features)
GRADIUM_API_KEY=
